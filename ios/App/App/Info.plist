<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Bottle Cap Chaos</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- The clock and the battery over the top of the board. `CAPBridgeViewController`
	     reads this key in `setStatusBarDefaults()` and reports it through
	     `prefersStatusBarHidden`, so the key above stays true and this one does the
	     work. Note that hiding the bar does NOT give the pixels back on a notched
	     phone — the sensor housing still owns them — which is why the safe-area
	     insets are read at runtime rather than assumed away. -->
	<key>UIStatusBarHidden</key>
	<true/>

	<!-- ══ DEVELOPMENT ONLY — remove before any build that leaves this machine ══
	     The relay runs on a Mac on the same wifi and is reached over plain ws://
	     on port 8787. ATS blocks cleartext by default, and a WebSocket opened from
	     the web view goes through the same policy as any other load.

	     `NSAllowsArbitraryLoads` is the blunt instrument and it is the right one
	     for a verification build: the alternative, `NSExceptionDomains`, needs the
	     Mac's address written down, and that address changes with the network.
	     `NSAllowsLocalNetworking` is narrower and stated alongside it on purpose —
	     it is what should REPLACE the arbitrary-loads key once the relay is
	     addressed by a stable name, and it is a no-op while the broader key is
	     present. The production answer is neither: it is wss://, at which point
	     both keys come out. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- iOS 14+ gates every connection to a LAN address behind a permission
	     prompt, and an app with no usage description cannot even show the prompt —
	     the connection just fails, silently, with no error the page can see. This
	     string is the prompt's text.

	     No `NSBonjourServices`: that key is for discovery, and the address is
	     typed in by hand on the 설정 screen rather than browsed for. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 와이파이에 있는 대전 서버에 연결해 온라인 대전을 진행합니다.</string>

	<!-- The launch storyboard paints `systemBackgroundColor`, which is white on a
	     phone in light mode and near-black on one in dark mode. The game is a
	     single bright scheme with no dark variant, so on a dark-mode phone the
	     launch screen was the one black frame in the whole app — and it is the
	     FIRST frame, before the web view exists to say otherwise. Pinning the
	     app's interface style keeps that seam light for everyone. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>

{
  "name": "midsummer-alkkagi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Midsummer Alkkagi — desktop bottle-cap physics game, three modes",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "vite build && node tools/pages-routes.mjs",
    "preview:pages": "BCC_BASE=/bottle-cap-chaos/ npm run build:pages && BCC_BASE=/bottle-cap-chaos/ vite preview",
    "det:emit": "node tools/determinism/harness.mjs emit",
    "det:node": "node tools/determinism/harness.mjs run",
    "det:jsc": "vite build --config tools/determinism/vite.jsc.config.js && /System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Helpers/jsc tools/determinism/build/jsc-bundle.js",
    "det:collect": "node tools/determinism/collect.mjs",
    "det:ai": "node tools/determinism/ai-harness.mjs run",
    "det:ai:stats": "node tools/determinism/ai-harness.mjs stats",
    "server": "node server/index.js",
    "server:lan": "node tools/lan-address.mjs && node server/index.js",
    "server:test": "node server/test/flow.test.mjs && node server/test/lockstep.test.mjs && node server/test/resilience.test.mjs",
    "server:live": "node server/test/live.mjs",
    "test": "npm run det:node && npm run server:test && npm run det:ai"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "lil-gui": "^0.21.0",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  }
}
